# Server runtime
NODE_ENV=development
PORT=3001
DATA_DIR=./data
CORS_ORIGIN=http://localhost:5173
REQUEST_TIMEOUT_MS=20000
RUN_RATE_LIMIT=30

# LLM_MODE=mock uses a deterministic planner. `openai` calls the server-side Responses API.
LLM_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# GitHub mock mode makes no GitHub requests. For live mode, configure a GitHub App
# and provide all four values below. Do not prefix any secret with VITE_.
GITHUB_MODE=mock
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_CALLBACK_URL=http://localhost:5173/api/integrations/github/callback
GITHUB_TOKEN_ENCRYPTION_KEY=

# Enable only when the GitHub App has Contents: write AND Pull requests: write.
# Issue creation still requires per-action user approval.
GITHUB_APP_CONTENTS_WRITE=false

# Optional checklist criteria: readme,setup,license,demo,contributing,
# codeofconduct,security,changelog. Default: readme,setup,license,demo,contributing.
GITHUB_READINESS_REQUIREMENTS=readme,setup,license,demo,contributing
